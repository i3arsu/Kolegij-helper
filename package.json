{
  "name": "pracenje",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose -f docker-compose.dev.yml --env-file .env up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml --env-file .env down",
    "db:migrate": "dbmate --env OWNER_DATABASE_URL --migrations-dir db/migrations --no-dump-schema --wait up",
    "db:types": "kysely-codegen --url \"env(OWNER_DATABASE_URL)\" --out-file lib/db/tipovi.ts --exclude-pattern public.schema_migrations",
    "seed": "tsx scripts/seed.ts",
    "kreiraj-admina": "tsx scripts/kreiraj-admina.ts",
    "test": "vitest run tests/unit",
    "test:db": "vitest run --config vitest.db.config.mts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@node-rs/argon2": "^2.2.2",
    "date-fns": "^4.4.0",
    "kysely": "^0.29.6",
    "next": "16.4.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dbmate": "^2.36.0",
    "dotenv": "^18.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "kysely-codegen": "^0.20.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
