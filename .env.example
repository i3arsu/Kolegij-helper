# Kopirajte u .env i zamijenite svaku vrijednost "promijeni".
# Lozinke: samo slova, brojke, - i _  (Docker Compose tumači $ kao varijablu).
# Svaka lozinka piše se samo ovdje; URL-ove baze aplikacija i skripte grade same (lib/db/url.ts).
# Ako promijenite lozinke baze NAKON prvog `npm run db:up`, bazu treba ponovno kreirati:
#   npm run db:down -- -v  &&  npm run db:up  &&  npm run db:migrate  &&  npm run seed

# Baza (lokalni razvoj)
DB_HOST=127.0.0.1
# Na Windowsu izbjegavati 49152–65535 (Hyper-V rezervira dijelove tog raspona)
DB_PORT=5433
DB_NAME=pracenje
POSTGRES_PASSWORD=promijeni
# app_owner: migracije i seed
APP_OWNER_PASS=promijeni
# app_user: svi korisnički upiti (pod RLS-om)
APP_USER_PASS=promijeni
# app_auth: prijava i sesije
APP_AUTH_PASS=promijeni

# Aplikacija
QR_TAJNA=promijeni-64-hex-znaka
APP_URL=http://localhost:3000
# Lozinka svih seed računa (samo razvoj; seed se odbija pokrenuti u produkciji)
SEED_LOZINKA=promijeni

# Produkcija (docker-compose.yml): javna domena za Caddy TLS
DOMENA=pracenje.unipu.hr

# Napredno: umjesto gornjih dijelova može se zadati cijeli URL (ima prednost), npr.
# OWNER_DATABASE_URL=postgres://app_owner:...@host:5432/pracenje?sslmode=disable
# DATABASE_URL=...   AUTH_DATABASE_URL=...
