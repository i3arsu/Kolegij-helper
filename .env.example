# Kopiraj u .env i zamijeni sve vrijednosti (npr. openssl rand -base64 24).
# Port baze na računalu (dev). Na Windowsu izbjegavati 49152–65535 (Hyper-V rezervira dijelove tog raspona).
DB_PORT=5433
POSTGRES_PASSWORD=promijeni
APP_OWNER_PASS=promijeni
APP_USER_PASS=promijeni
APP_AUTH_PASS=promijeni
# app_owner: samo migracije i seed
OWNER_DATABASE_URL=postgres://app_owner:promijeni@127.0.0.1:5433/pracenje?sslmode=disable
# app_user: svi korisnički upiti (pod RLS-om)
DATABASE_URL=postgres://app_user:promijeni@127.0.0.1:5433/pracenje
# app_auth: prijava i sesije
AUTH_DATABASE_URL=postgres://app_auth:promijeni@127.0.0.1:5433/pracenje
QR_TAJNA=promijeni-64-hex-znaka
APP_URL=http://localhost:3000
# Lozinka svih seed računa (samo razvoj; seed se odbija pokrenuti u produkciji)
SEED_LOZINKA=promijeni
# Produkcija (docker-compose.yml): javna domena za Caddy TLS
DOMENA=pracenje.unipu.hr
# Lozinke u URL-ovima: koristite samo znakove A-Z a-z 0-9 - _ (npr. openssl rand -hex 24)
